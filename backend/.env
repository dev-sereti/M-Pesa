# ──────────────────────────────────────────────────────────────────────────────
# NEVER commit this file with real values to version control.
# Copy this to .env and fill in production values.
# ──────────────────────────────────────────────────────────────────────────────

# Application
APP_NAME="MPesa Statement Processor"
ENVIRONMENT=development
DEBUG=false

# Security - Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_USE_A_REAL_64_CHAR_SECRET_KEY_IN_PRODUCTION

# Database
DATABASE_URL=sqlite:///./mpesa_app.db

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80

# File Storage
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
MAX_FILE_SIZE_MB=10
FILE_RETENTION_HOURS=24

# Rate Limiting
RATE_LIMIT_PER_MINUTE=30
LOGIN_RATE_LIMIT=5